    <hediffClass>HediffWithComps</hediffClass>
    <label>inspired by brave presence</label>
    <labelNoun>brave presence</labelNoun>
    <description>Just a flesh wound.</description>
    <defaultLabelColor>(206,126,0)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>500</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.9</painFactor>
        <statOffsets>
          <PainShockThreshold>0.1</PainShockThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

