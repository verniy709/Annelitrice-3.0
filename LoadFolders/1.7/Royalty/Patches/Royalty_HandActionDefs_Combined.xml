                            <value>
                                <li>ArmHandMidG/</li>
                            </value>
                        </li>
                    </pathDict>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[(defName="Anneli_Arm_Generic_Left")]/behaviors/li[(key="BestowingCeremony")]/value[not(pathDict)]</xpath>
                <value>
                    <pathDict>
                        <li>
                            <key>Standing</key>
                            <value>
                                <li>ArmStraightA/</li>
                            </value>
                        </li>
                    </pathDict>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[(defName="Anneli_Arm_Generic_Right")]/behaviors/li[(key="Reign")]/value[not(pathDict)]</xpath>
                <value>
