            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[(defName="Anneli_Arm_Generic_Left")]/behaviors/li[(key="LinkPsylinkable")]/value[not(pathDict)]</xpath>
                <value>
                    <pathDict>
                        <li>
