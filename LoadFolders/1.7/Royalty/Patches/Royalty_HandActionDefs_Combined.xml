                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[(defName="Anneli_Arm_Generic_Right")]/behaviors/li[(key="LinkPsylinkable")]/value[not(pathDict)]</xpath>
