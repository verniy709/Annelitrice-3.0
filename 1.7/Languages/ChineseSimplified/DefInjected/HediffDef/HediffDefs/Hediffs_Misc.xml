  <Anneli_Regeneration.description>安妮莉特丝重生.</Anneli_Regeneration.description>
  <!-- EN: Destroyed -->
  <Anneli_Regeneration.injuryProps.destroyedLabel>已被毁</Anneli_Regeneration.injuryProps.destroyedLabel>
