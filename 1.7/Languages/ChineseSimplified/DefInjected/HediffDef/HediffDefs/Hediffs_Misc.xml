<LanguageData>
  <!-- EN: This hediff causes the target to produce 2–4 outsider eggs per in-game day. The eggs hatch into new pawns belonging to the player's faction. -->
  <Anneli_Infection.description>这个异常状态会让目标每个游戏日产生2-4个安妮莉蛋。这些蛋会孵化成新的人物，归属于玩家的阵营。</Anneli_Infection.description>
  <!-- EN: annelitrice infestation -->
  <Anneli_Infection.label>安妮莉特丝寄生</Anneli_Infection.label>
  <!-- EN: annelitrice infestation -->
  <Anneli_Infection.labelNoun>安妮莉特丝寄生</Anneli_Infection.labelNoun>
  <!-- EN: Early-stage -->
  <Anneli_Infection.stages.0.label>早期</Anneli_Infection.stages.0.label>
  <!-- EN: Middle-stage -->
  <Anneli_Infection.stages.1.label>中期</Anneli_Infection.stages.1.label>
  <!-- EN: Late-stage -->
  <Anneli_Infection.stages.2.label>晚期</Anneli_Infection.stages.2.label>
  <!-- EN: Final-stage -->
  <Anneli_Infection.stages.3.label>最终阶段</Anneli_Infection.stages.3.label>
  <!-- EN: Well-fed larvae will eventually pupate. -->
  <Anneli_Pupation.description>吃饱喝足的幼虫会逐渐化蛹。</Anneli_Pupation.description>
  <!-- EN: annelitrice pupation -->
  <Anneli_Pupation.label>安妮莉特丝蛹化</Anneli_Pupation.label>
  <!-- EN: minor -->
