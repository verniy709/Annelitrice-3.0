<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Annelitrice_RJWPatch</AssemblyName>
    <ModRoot Condition="'$(ModRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..</ModRoot>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">$(ModRoot)\..\..</RimWorldRoot>
    <WorkshopContentRoot Condition="'$(WorkshopContentRoot)' == ''">$(RimWorldRoot)\..\..\workshop\content\294100</WorkshopContentRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Compile Include="Annelitrice_RJWHarmonyPatches\Patch_Main.cs" />
    <Compile Include="Annelitrice_RJWHarmonyPatches\Patch_CompRJW.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Reference Include="$(RimWorldRoot)\System*.dll" Exclude="$(RimWorldRoot)\System.IO.Compression.Native.dll" />
    <Reference Include="$(RimWorldRoot)\mscorlib.dll" />
    <Reference Include="$(RimWorldRoot)\netstandard.dll" />
    <Reference Include="$(RimWorldRoot)\Assembly-CSharp.dll" />
    <Reference Include="$(RimWorldRoot)\UnityStubs.dll" />
    <Reference Include="$(WorkshopContentRoot)\2009463077\1.7\Assemblies\0Harmony.dll" />
    <Reference Include="$(WorkshopContentRoot)\2009463077\1.7\Assemblies\HarmonyMod.dll" />
    <Reference Include="$(ModRoot)\1.7\Assemblies\Annelitrice.dll" />
    <Reference Include="$(RimWorldRoot)\Mods\rjw\1.6\Assemblies\RJW.dll" />
  </ItemGroup>
  <Target Name="DeployToMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModRoot)\LoadFolders\1.7\RJW\Assemblies\" />
  </Target>
</Project>